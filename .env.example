# ==============================================================================
# Campus Knowledge Assistant (CampusRAG) - Configuration
# Optimized for German Tech Enterprise / GDPR-Compliant Deployments
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Embedding Configuration
# Options:
# 1. "sentence-transformers/all-MiniLM-L6-v2" (Default: Local, 384-d, 0 data egress, GDPR-compliant)
# 2. "text-embedding-3-small" (OpenAI: requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Vector Storage Configuration
# Persistent ChromaDB directory
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=campus_knowledge_base

# Ingestion & Chunking Parameters
# 500-800 characters (~100-150 tokens) offers optimal balance for dense retrieval precision
CHUNK_SIZE=750
CHUNK_OVERLAP=150

# RAG Retrieval & Similarity Threshold
# Cosine similarity cutoff: documents below this threshold are discarded as irrelevant
SIMILARITY_THRESHOLD=0.35
TOP_K=4

# LLM Generation Provider
# Options:
# 1. "ollama" - Local inference (Llama 3 / Mistral) via Ollama service
# 2. "openai" - OpenAI Chat Completions API
# 3. "mock"   - High-fidelity grounded deterministic synthesizer (failsafe when no API key / Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Optional: OpenAI API Key (only if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=

# Frontend Configuration
BACKEND_API_URL=http://localhost:8000/api/v1
